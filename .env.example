# GOV.UK Notify
NOTIFY_API_KEY:

# ── Auth — Defra ID (operators, optional alongside stub) ────────────────────
# When set, a "Sign in with Defra ID" button appears on the stub chooser.
# To use the local Defra ID stub (epr-register-enrol-defra-id-stub) instead of
# real Defra ID, start its compose profile and point the operator frontend at
# it (the client id/secret are the stub's defaults):
#   COMPOSE_PROFILES: defra-id-stub
#   DEFRA_ID_CLIENT_ID: epr-register-enrol-frontend
#   DEFRA_ID_CLIENT_SECRET: operator-journey-stub-secret
#   DEFRA_ID_DISCOVERY_URL: http://epr-register-enrol-defra-id-stub:3000/.well-known/openid-configuration
DEFRA_ID_CLIENT_ID: 
DEFRA_ID_CLIENT_SECRET: 
DEFRA_ID_DISCOVERY_URL: 
DEFRA_ID_SERVICE_ID: 
DEFRA_ID_TENANT_ID: 

# ── Auth — Azure Entra ID (regulators, optional alongside stub) ───────────────
# When set, a "Sign in with Entra ID" button appears on the stub login page.

# Case management service
ENTRA_CLIENT_ID_CASE_MANAGEMENT:
ENTRA_CLIENT_SECRET_CASE_MANAGEMENT:
ENTRA_TENANT_ID_CASE_MANAGEMENT:
# App role (value, not display name) a signed-in user must hold to be treated
# as a caseworker. Defaults to 'Waste.Regulator.Standard' if unset — RA-323.
ENTRA_REGULATOR_ROLE_VALUE_CASE_MANAGEMENT:
# App role a signed-in user must hold to be treated as a read-only support
# user. Defaults to 'Waste.SupportUser.ReadOnly' if unset — RA-335.
ENTRA_SUPPORT_USER_ROLE_VALUE_CASE_MANAGEMENT:
