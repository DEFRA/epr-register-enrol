{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh run *)",
      "Bash(gh pr *)"
    ],
    "deny": [
      "Read(./diagnostics/**/*.jsonl)",
      "Read(./diagnostics/**/*.jsonl*)",
      "Read(./diagnostics/**/*.archive)",
      "Read(./diagnostics/**/*.enc)",
      "Read(./diagnostics/**/out/**)"
    ]
  }
}
